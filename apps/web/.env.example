# FlowLedger web: environment template. Copy to .env.local (never commit real values).
# Local dev: `node scripts/dev-env.mjs` (from the repo root) writes .env.local with fresh secrets.
# Every variable is validated per process role by @flowledger/config (packages/config/src/env.ts).

# --- Core ---
# App connection: a least-privilege role (NOT the table owner) so row-level security applies.
DATABASE_URL=postgres://flowledger_app:flowledger_app@localhost:5433/flowledger_utf8
# Owner connection: migrations (pnpm db:migrate) and system jobs only.
DATABASE_ADMIN_URL=postgres://flowledger:flowledger@localhost:5433/flowledger_utf8
# true in production: refuse to start if RLS would be bypassed.
REQUIRE_RLS=false
# 64 hex chars (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
# Vault master keys (envelope encryption). Highest version is current; add _V2 to rotate.
# Falls back to INTEGRATION_ENCRYPTION_KEY as v1 when unset.
VAULT_MASTER_KEY_V1=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Sign in with Google" (P2, key K9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Queue (Hive engine, P1C) ---
REDIS_URL=redis://localhost:6379

# --- AI (P2, key K4). Model names come from env only. ---
AI_PRIMARY_PROVIDER=google
AI_MODEL_FAST=
AI_MODEL_SMART=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# --- Proof-of-Execution ledger (P1F local anvil; P2 Polygon Amoy, key K10/K11) ---
CHAIN_ID=31337
CHAIN_RPC_URL=http://localhost:8545
ANCHOR_CONTRACT_ADDRESS=
# Testnet-only wallet. Never a wallet that holds real funds.
ANCHORER_PRIVATE_KEY=
EXPLORER_BASE_URL=
ANCHOR_INTERVAL_MS=30000
