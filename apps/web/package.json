{
  "name": "@flowledger/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "N-Flow web app (UI, API, trigger ingress). Forked from vercel-labs/workflow-builder-template (Apache-2.0).",
  "scripts": {
    "dev": "pnpm discover-plugins && next dev",
    "build": "pnpm discover-plugins && next build",
    "start": "next start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx scripts/hive-setup.ts",
    "db:push": "echo \"db:push is disabled: RLS policies live in SQL migrations. Use pnpm db:migrate.\" && exit 1",
    "db:studio": "drizzle-kit studio",
    "discover-plugins": "tsx scripts/discover-plugins.ts",
    "create-plugin": "tsx scripts/create-plugin.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:vercel": "tsx scripts/migrate-prod.ts && pnpm discover-plugins && next build",
    "typecheck": "pnpm discover-plugins && tsc --noEmit",
    "lint": "ultracite check",
    "test": "vitest run",
    "hive:setup": "tsx scripts/hive-setup.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "cloud:db": "tsx scripts/cloud.ts db",
    "cloud:env": "tsx scripts/cloud.ts env",
    "eval:copilot": "tsx --conditions=react-server scripts/eval-copilot.ts",
    "eval:ai": "tsx --conditions=react-server scripts/eval-ai-steps.ts",
    "check:google": "tsx --conditions=react-server scripts/check-google-oauth.ts",
    "check:connections": "tsx --conditions=react-server scripts/check-connections.ts",
    "e2e:live": "node scripts/e2e-live.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.102",
    "@ai-sdk/groq": "^2.0.57",
    "@ai-sdk/provider": "^2.0.0",
    "@flowledger/engine": "workspace:*",
    "@linear/sdk": "^63.2.0",
    "@mendable/firecrawl-js": "^4.6.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@slack/web-api": "^7.12.0",
    "@vercel/og": "^0.8.5",
    "@vercel/sdk": "^1.17.1",
    "@xyflow/react": "^12.9.2",
    "ai": "^5.0.102",
    "animejs": "4.5.0",
    "better-auth": "^1.7.7",
    "canonicalize": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.2.0",
    "jose": "^6.1.3",
    "jotai": "^2.15.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.16",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "openai": "^6.8.1",
    "pg-boss": "^12.37.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^3.0.6",
    "resend": "^6.4.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "0.186.1",
    "v0-sdk": "^0.15.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@electric-sql/pglite": "^0.5.8",
    "@inquirer/prompts": "^8.0.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^5.70.1",
    "prettier": "^3.7.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "ultracite": "6.3.0",
    "vitest": "^5.0.3"
  }
}
