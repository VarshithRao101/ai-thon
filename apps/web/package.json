    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@slack/web-api": "^7.12.0",
    "@vercel/og": "^0.8.5",
    "@vercel/sdk": "^1.17.1",
    "@xyflow/react": "^12.9.2",
    "ai": "^5.0.102",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.3",
    "jotai": "^2.15.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.16",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "openai": "^6.8.1",
    "postgres": "^3.4.7",
    "radix-ui": "^1.4.3",
