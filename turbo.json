{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalDependencies": [
    ".node-version"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "INTEGRATION_ENCRYPTION_KEY",
        "AI_*",
        "VERCEL_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
